# Cyberpunk 2077 — btop as a Night City diagnostics readout.
theme[main_bg]="#0D0B10"
theme[main_fg]="#FF6159"
theme[title]="#5EF6FF"
theme[hi_fg]="#5EF6FF"
theme[selected_bg]="#10353A"
theme[selected_fg]="#5EF6FF"
theme[inactive_fg]="#7D4446"
theme[graph_text]="#FF8C82"
theme[meter_bg]="#2A1418"
theme[proc_misc]="#5EF6FF"

# Box frames: coral panels like the in-game menus.
theme[cpu_box]="#FF6159"
theme[mem_box]="#FF6159"
theme[net_box]="#FF6159"
theme[proc_box]="#FF6159"
theme[div_line]="#5A1E24"

# Load scales cyan (cool) -> coral -> alarm red (hot).
theme[temp_start]="#5EF6FF"
theme[temp_mid]="#F3E600"
theme[temp_end]="#FF003C"

theme[cpu_start]="#5EF6FF"
theme[cpu_mid]="#FF6159"
theme[cpu_end]="#FF003C"

theme[free_start]="#10353A"
theme[free_mid]="#2C8C94"
theme[free_end]="#5EF6FF"

theme[cached_start]="#5A1E24"
theme[cached_mid]="#A3463F"
theme[cached_end]="#FF8C82"

theme[available_start]="#10353A"
theme[available_mid]="#2C8C94"
theme[available_end]="#5EF6FF"

theme[used_start]="#A3463F"
theme[used_mid]="#FF6159"
theme[used_end]="#FF003C"

theme[download_start]="#10353A"
theme[download_mid]="#2C8C94"
theme[download_end]="#5EF6FF"

theme[upload_start]="#5A1E24"
theme[upload_mid]="#FF6159"
theme[upload_end]="#F3E600"

theme[process_start]="#5EF6FF"
theme[process_mid]="#FF6159"
theme[process_end]="#FF003C"
