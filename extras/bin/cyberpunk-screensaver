#!/bin/bash
# Set Omarchy's screensaver to the Cyberpunk 2077 box-art logo.
#
# The logo is CD Projekt RED's trademarked artwork, so it isn't in this repo.
# Instead this fetches the official Ultimate Edition wallpaper from
# cyberpunk.net (black logo on flat yellow), traces the logo into Braille
# characters sized for the screensaver, backs up your current screensaver and
# installs it. The screensaver text is global, not per theme.
#
#   cyberpunk-screensaver             install
#   cyberpunk-screensaver --print     just print the art
#   cyberpunk-screensaver --restore   put back the screensaver it replaced

set -euo pipefail

THEME_DIR="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
CACHE="$HOME/.cache/omarchy-cyberpunk-2077"
TARGET="$HOME/.config/omarchy/branding/screensaver.txt"
BACKUP="$TARGET.before-cyberpunk"
SOURCE="$CACHE/43-ultimate-edition.png"

if [[ ${1:-} == --restore ]]; then
  [[ -f $BACKUP ]] || { echo "No saved screensaver to restore." >&2; exit 1; }
  mv "$BACKUP" "$TARGET"
  echo "Previous screensaver restored."
  exit 0
fi

# Always the 1920x1080 version: the crop below is measured on that layout.
if [[ ! -s $SOURCE ]]; then
  "$THEME_DIR/extras/bin/cyberpunk-wallpapers" --only 43-ultimate-edition --res 1920x1080 --dest "$CACHE" >/dev/null
fi
[[ -s $SOURCE ]] || { echo "Could not download the Ultimate Edition wallpaper." >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# Cut out the logo and make it white on black.
magick "$SOURCE" -resize '1920x1080!' -crop 820x200+120+400 +repage \
  -colorspace gray -threshold 35% -negate -trim +repage "$tmp/logo.png"

# 86 columns fits the screensaver even on a 1080p screen at 1.6x scaling.
art=$(python3 -I - "$tmp/logo.png" <<'PY'
import subprocess, sys
src, cols = sys.argv[1], 86
sw, sh = map(int, subprocess.run(["magick", "identify", "-format", "%w %h", src],
                                 capture_output=True, text=True, check=True).stdout.split())
w = cols * 2
h = round(w * sh / sw)          # Braille dots are roughly square
h += (-h) % 4
pbm = subprocess.run(["magick", src, "-resize", f"{w}x{h}!", "-threshold", "40%",
                      "-compress", "none", "pbm:-"], capture_output=True, text=True, check=True).stdout.split()
W, H, px = int(pbm[1]), int(pbm[2]), pbm[3:]
on = lambda y, x: y < H and x < W and px[y * W + x] == "0"
dots = [(0, 0, 0x01), (1, 0, 0x02), (2, 0, 0x04), (0, 1, 0x08), (1, 1, 0x10), (2, 1, 0x20), (3, 0, 0x40), (3, 1, 0x80)]
rows = []
for y in range(0, H, 4):
    row = "".join(chr(0x2800 + sum(b for dy, dx, b in dots if on(y + dy, x + dx))) for x in range(0, W, 2))
    row = row.replace("⠀", " ").rstrip()
    if row:
        rows.append(row)
tag = "2 ── 0 ── 7 ── 7"
rows += ["", " " * (cols - len(tag) - 14) + tag]
print("\n".join(rows))
PY
)

if [[ ${1:-} == --print ]]; then
  echo "$art"
  exit 0
fi

mkdir -p "$(dirname "$TARGET")"
if [[ -f $TARGET && ! -f $BACKUP ]] && [[ $(<"$TARGET") != "$art" ]]; then
  cp "$TARGET" "$BACKUP"
  echo "Saved your current screensaver to $BACKUP"
fi
echo "$art" >"$TARGET"
echo "Screensaver set to the Cyberpunk 2077 logo. Preview: omarchy-launch-screensaver force"
