#!/bin/bash
# Cybergram: Telegram as V's phone, the Telegram twin of Cyberphone.
#
# Runs Telegram Web A (web.telegram.org/a) as a Chromium app window with its
# own profile, and loads the Night City skin (extras/telegram-web/
# night-city.css) as a small local extension that is rebuilt from the theme
# each launch. Unlike a Telegram Desktop theme, the skin reshapes everything:
# square bubbles and portraits, HUD edges, the grid behind the chat.
# First launch: log in with the QR code (Telegram > Settings > Devices >
# Link Desktop Device) or your phone number.
#
#   cybergram             open it (Super+Shift+Alt+T)
#   cybergram --install   add "Cybergram" to the app launcher
#   cybergram --remove    remove the launcher entry, profile and login
#
#   CYBERGRAM_DEBUG=1 cybergram   also open Chromium's DevTools port on
#                                 127.0.0.1:9334 (for working on the skin)

set -euo pipefail

THEME_DIR="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
SKIN="$THEME_DIR/extras/telegram-web"
DATA="$HOME/.local/share/cybergram"
DESKTOP="$HOME/.local/share/applications/cybergram.desktop"
URL="https://web.telegram.org/a/"

case ${1:-} in
  --install)
    mkdir -p "$(dirname "$DESKTOP")"
    cat >"$DESKTOP" <<EOF
[Desktop Entry]
Name=Cybergram
Comment=Telegram as V's phone (Night City skin)
Exec=$HOME/.local/bin/cybergram
Icon=$THEME_DIR/extras/whatsapp/cyberphone.png
Terminal=false
Type=Application
Categories=Network;InstantMessaging;
StartupWMClass=chrome-web.telegram.org__a_-Default
EOF
    echo "Cybergram added to the app launcher"
    exit 0
    ;;
  --remove)
    rm -rf "$DATA" "$DESKTOP"
    echo "Cybergram removed (log the session out on your phone under Devices)"
    exit 0
    ;;
  -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  "") ;;
  *) echo "Unknown option: $1" >&2; exit 1 ;;
esac

# Rebuild the extension from the theme on every launch, so a git pull of the
# theme updates the skin.
ext="$DATA/extension"
mkdir -p "$ext" "$DATA/profile"
cp "$SKIN/night-city.css" "$ext/"
cat >"$ext/manifest.json" <<'EOF'
{
  "manifest_version": 3,
  "name": "Cybergram: Night City Telegram",
  "version": "1.0",
  "description": "Skins Telegram Web A as the phone in Cyberpunk 2077.",
  "content_scripts": [{
    "matches": ["https://web.telegram.org/*"],
    "css": ["night-city.css"],
    "run_at": "document_start"
  }]
}
EOF

browser=chromium
command -v chromium >/dev/null || browser=$(command -v google-chrome-stable || command -v brave || true)
[[ -n $browser ]] || { echo "Cybergram needs Chromium (omarchy pkg add chromium)." >&2; exit 1; }

debug=()
[[ ${CYBERGRAM_DEBUG:-} == 1 ]] && debug=(--remote-debugging-address=127.0.0.1 --remote-debugging-port=9334)

exec setsid "$browser" "${debug[@]}" \
  --user-data-dir="$DATA/profile" \
  --class=cybergram \
  --app="$URL" \
  --load-extension="$ext" \
  --disable-features=DisableLoadExtensionCommandLineSwitch \
  --force-dark-mode \
  --no-first-run --no-default-browser-check \
  >/dev/null 2>&1
